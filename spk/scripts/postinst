#!/bin/sh
# DSM 7 refuses `capabilities` in conf/privilege for third-party packages,
# so the setuid helper declared there gives bin/synofile its capabilities.
# postinst runs on install and on upgrade, before the package starts, so the
# daemon starts with them. If DSM did not make the helper setuid, nothing
# happens: the interface then says to run `synofile setup` as before.

HELPER="/var/packages/synofile/target/bin/helper/synofile-helper"

if [ -u "$HELPER" ] && [ -x "$HELPER" ]; then
    out=$("$HELPER" 2>&1)
    echo "synofile postinst: helper exit=$? $out"
fi

exit 0
