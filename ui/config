{
    "synofile.js": {
        "SYNO.SDS.SynoFile.Instance": {
            "type": "app",
            "title": "SynoFile",
            "desc": "File manager for the shared folders",
            "appWindow": "SYNO.SDS.SynoFile.Instance",
            "icon": "images/icon_{0}.png",
            "allUsers": false,
            "allowMultiInstance": false,
            "hidden": false,
            "depend": [],
            "texts": "texts",
            "preloadTexts": [
                "app:title"
            ]
        }
    },
    "tray.js": {
        "SYNO.SDS.SynoFile.Tray.Instance": {
            "type": "app",
            "title": "SynoFile",
            "hidden": true,
            "autoLaunch": true,
            "autoLaunchType": "tray",
            "allUsers": false,
            "canLaunch": {
                "standalone": false,
                "demo_mode": false
            },
            "depend": [
                "SYNO.SDS.SynoFile.Tray.Item"
            ]
        },
        "SYNO.SDS.SynoFile.Tray.Item": {
            "type": "lib",
            "title": "SynoFile",
            "depend": [
                "SYNO.SDS.Tray.ArrowTray"
            ]
        }
    }
}
