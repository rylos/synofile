# GitHub Dark (Primer) — truecolor, sfondo del terminale (trasparenza di foot)
color-link default "#e6edf3"
color-link comment "#8b949e"
color-link identifier "#d2a8ff"
color-link identifier.class "#ffa657"
color-link identifier.var "#ffa657"
color-link constant "#79c0ff"
color-link constant.number "#79c0ff"
color-link constant.bool "#79c0ff"
color-link constant.string "#a5d6ff"
color-link constant.string.char "#a5d6ff"
color-link constant.specialChar "#79c0ff"
color-link statement "#ff7b72"
color-link symbol "#ff7b72"
color-link symbol.operator "#ff7b72"
color-link symbol.brackets "#e6edf3"
color-link symbol.tag "#7ee787"
color-link preproc "#ff7b72"
color-link type "#ffa657"
color-link type.keyword "#ff7b72"
color-link special "#79c0ff"
color-link underlined "underline #a5d6ff"
color-link error "bold #f85149"
color-link todo "bold #d29922"
color-link hlsearch "#161723,#d29922"
color-link selection "#e6edf3,#264f78"
color-link match-brace "bold #e6edf3,#3a4250"
color-link statusline "#e6edf3,#161b22"
color-link statusline.inactive "#8b949e,#161b22"
color-link tabbar "#8b949e,#161b22"
color-link tabbar.active "#e6edf3"
color-link indent-char "#30363d"
color-link line-number "#6e7681"
color-link current-line-number "#e6edf3,#21262d"
color-link cursor-line "#21262d"
color-link color-column "#21262d"
color-link gutter-error "#f85149"
color-link gutter-warning "#d29922"
color-link diff-added "#3fb950"
color-link diff-modified "#d29922"
color-link diff-deleted "#f85149"
color-link divider "#30363d"
color-link scrollbar "#484f58"
color-link message "#e6edf3"
color-link error-message "#f85149"
color-link trailingws "#484f58"
