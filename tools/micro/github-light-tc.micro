# GitHub Light (Primer) — truecolor
color-link default "#1f2328,#ffffff"
color-link comment "#6e7781"
color-link identifier "#8250df"
color-link identifier.class "#953800"
color-link identifier.var "#953800"
color-link constant "#0550ae"
color-link constant.number "#0550ae"
color-link constant.bool "#0550ae"
color-link constant.string "#0a3069"
color-link constant.string.char "#0a3069"
color-link constant.specialChar "#0550ae"
color-link statement "#cf222e"
color-link symbol "#cf222e"
color-link symbol.operator "#cf222e"
color-link symbol.brackets "#1f2328"
color-link symbol.tag "#116329"
color-link preproc "#cf222e"
color-link type "#953800"
color-link type.keyword "#cf222e"
color-link special "#0550ae"
color-link underlined "underline #0a3069"
color-link error "bold #cf222e"
color-link todo "bold #9a6700"
color-link hlsearch "#1f2328,#fff8c5"
color-link selection "#1f2328,#b6e3ff"
color-link match-brace "bold #1f2328,#d0d7de"
color-link statusline "#1f2328,#f6f8fa"
color-link statusline.inactive "#6e7781,#f6f8fa"
color-link tabbar "#6e7781,#f6f8fa"
color-link tabbar.active "#1f2328,#ffffff"
color-link indent-char "#d0d7de"
color-link line-number "#8c959f,#ffffff"
color-link current-line-number "#1f2328,#f6f8fa"
color-link cursor-line "#f6f8fa"
color-link color-column "#f6f8fa"
color-link gutter-error "#cf222e"
color-link gutter-warning "#9a6700"
color-link diff-added "#1a7f37"
color-link diff-modified "#9a6700"
color-link diff-deleted "#cf222e"
color-link divider "#d0d7de,#ffffff"
color-link scrollbar "#8c959f"
color-link message "#1f2328"
color-link error-message "#cf222e"
